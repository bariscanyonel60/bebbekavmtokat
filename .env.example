# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. Gerçek değerleri asla commit etmeyin.

# MySQL bağlantısı. Yerel geliştirme için `npm run db:local` çıktısındaki değeri kullanabilirsiniz.
DATABASE_URL=

# Canonical, sitemap ve WhatsApp ürün linkleri için (admin › Site Ayarları'ndaki "Site adresi" önceliklidir).
# Production: https://bebbekavm.com (boş bırakılırsa production build bu adresi kullanır).
SITE_URL=http://localhost:3000

# Admin oturumlarını imzalar. En az 32 karakter, rastgele: `openssl rand -base64 48`
AUTH_SECRET=

# İlk admin kullanıcısı; yalnızca `npm run db:seed` sırasında okunur.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Seed varsayılan olarak yalnızca localhost veritabanına yazar. Uzak veritabanına bilerek seed atmak için "true".
SEED_ALLOW_REMOTE=

# Görsel yükleme. Üçü de doluysa Cloudinary kullanılır; boşsa dosyalar UPLOAD_DIR klasörüne yazılır.
# Serverless ortamlarda (Vercel/Netlify) disk kalıcı olmadığından Cloudinary zorunludur.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=.data/uploads
